{
  "version": 2,
  "framework": null,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.3.1"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "env": {
    "APP_ENV": "production",
    "APP_DEBUG": "false",
    "APP_URL": "https://yourproductionurl.com",

    "APP_CONFIG_CACHE": "storage/framework/cache/config.php",
    "APP_EVENTS_CACHE": "storage/framework/cache/events.php",
    "APP_PACKAGES_CACHE": "storage/framework/cache/packages.php",
    "APP_ROUTES_CACHE": "storage/framework/cache/routes.php",
    "APP_SERVICES_CACHE": "storage/framework/cache/services.php",
    "VIEW_COMPILED_PATH": "storage/framework/views",

    "CACHE_DRIVER": "file",
    "LOG_CHANNEL": "stderr",
    "SESSION_DRIVER": "file"
  }
}
